// SIMULATION STUB of the AWS HDK cl_ports.vh. Never upload this file: on AWS
// the real cl_ports.vh comes with the Custom Logic project.
// Declares only the shell ports that the organiser's top.sv references. Widths
// match the AWS HDK where top.sv depends on them (OCL AXI-Lite); all other
// widths are placeholders, because those ports are tied off.
    input  wire        clk_main_a0,
    input  wire        rst_main_n,
    // OCL AXI-Lite slave (32-bit address and data), driven by the testbench.
    input  wire        ocl_cl_awvalid,
    input  wire [31:0] ocl_cl_awaddr,
    output logic       cl_ocl_awready,
    input  wire        ocl_cl_wvalid,
    input  wire [31:0] ocl_cl_wdata,
    input  wire [3:0]  ocl_cl_wstrb,
    output logic       cl_ocl_wready,
    output logic       cl_ocl_bvalid,
    output logic [1:0] cl_ocl_bresp,
    input  wire        ocl_cl_bready,
    input  wire        ocl_cl_arvalid,
    input  wire [31:0] ocl_cl_araddr,
    output logic       cl_ocl_arready,
    output logic       cl_ocl_rvalid,
    output logic [31:0] cl_ocl_rdata,
    output logic [1:0] cl_ocl_rresp,
    input  wire        ocl_cl_rready,
    // Tied-off shell outputs.
    output logic cl_sh_flr_done, cl_sh_status_vled, cl_sh_dma_wr_full, cl_sh_dma_rd_full,
    output logic [31:0] cl_sh_status0, cl_sh_status1, cl_sh_status2, cl_sh_id0, cl_sh_id1,
    output logic cl_sh_dma_pcis_awready, cl_sh_dma_pcis_wready, cl_sh_dma_pcis_bvalid,
    output logic cl_sh_dma_pcis_arready, cl_sh_dma_pcis_rvalid, cl_sh_dma_pcis_rlast,
    output logic [1:0] cl_sh_dma_pcis_bresp, cl_sh_dma_pcis_rresp,
    output logic [15:0] cl_sh_dma_pcis_bid, cl_sh_dma_pcis_rid,
    output logic [511:0] cl_sh_dma_pcis_rdata,
    output logic [63:0] cl_sh_dma_pcis_ruser,
    output logic cl_sda_awready, cl_sda_wready, cl_sda_bvalid, cl_sda_arready, cl_sda_rvalid,
    output logic [1:0] cl_sda_bresp, cl_sda_rresp,
    output logic [31:0] cl_sda_rdata,
    output logic cl_sh_ddr_stat_ack, cl_sh_ddr_stat_int,
    output logic [31:0] cl_sh_ddr_stat_rdata,
    output logic cl_sh_apppf_irq_req,
    output logic tdo,
    output logic [31:0] hbm_apb_paddr_0, hbm_apb_paddr_1, hbm_apb_pwdata_0, hbm_apb_pwdata_1,
    output logic [31:0] hbm_apb_prdata_0, hbm_apb_prdata_1,
    output logic [2:0] hbm_apb_pprot_0, hbm_apb_pprot_1,
    output logic [3:0] hbm_apb_pstrb_0, hbm_apb_pstrb_1,
    output logic hbm_apb_psel_0, hbm_apb_psel_1, hbm_apb_penable_0, hbm_apb_penable_1,
    output logic hbm_apb_pwrite_0, hbm_apb_pwrite_1, hbm_apb_pready_0, hbm_apb_pready_1,
    output logic hbm_apb_pslverr_0, hbm_apb_pslverr_1,
    output logic PCIE_EP_TXP, PCIE_EP_TXN, PCIE_RP_PERSTN, PCIE_RP_TXP, PCIE_RP_TXN,
    // DDR pins pass straight through to the sh_ddr stub.
    input  wire CLK_DIMM_DP, CLK_DIMM_DN,
    output wire M_ACT_N, M_PAR, M_CKE, M_ODT, M_CS_N, M_CLK_DN, M_CLK_DP, RST_DIMM_N,
    output wire [16:0] M_MA,
    output wire [1:0] M_BA, M_BG,
    inout  wire [63:0] M_DQ,
    inout  wire [7:0] M_ECC,
    inout  wire [17:0] M_DQS_DP, M_DQS_DN
